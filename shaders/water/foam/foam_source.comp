#version 450
// 工作组大小：8x8 个线程，用于遍历泡沫状态图
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// 模拟域 UBO：包含世界空间范围、时间步长等信息
layout(set = 0, binding = 0) uniform FoamSimulationUBO {
    vec4 domain;      // xy=世界原点, zw=世界尺寸
    vec4 simulation;  // x=dt, y=时间, z=源增益, w=衰减
    vec4 solver;      // x=扩散, y=分辨率, z=逆分辨率, w=开关
} foamSim;

// 泡沫参数 UBO：控制源强度、阈值等
layout(set = 0, binding = 1) uniform FoamParamsUBO {
    vec4 animation;
    vec4 sourceStrength;
    vec4 thresholds;
    vec4 appearance;
    vec4 state;
    vec4 runtime;     // x=时间, y=全局源缩放等
} foam;

// 涌潮波前 UBO
layout(set = 0, binding = 2) uniform BoreFrontUBO {
    vec4 originSpeedTime;        // xy=原点, z=速度, w=时间
    vec4 directionLengthFade;    // xy=方向, z=长度, w=淡出比例
    vec4 motionDebug;            // x=初始偏移, y=剖面宽度, z=浪尖强度, w=涌潮开关
    vec4 lutInfo;                // x=分辨率, y=逆分辨率, z=是否启用LUT, w=预留
} bore;

// 涌潮剖面 UBO
layout(set = 0, binding = 3) uniform BoreProfileUBO {
    vec4 domain;        // x=半宽, y=水位抬升, z=过渡宽度, w=动画时长
    vec4 animation;     // x=动画时间, y=宽度缩放, z=模式(OneShot/Looping), w=剖面开关
    vec4 geometry;      // x=全局振幅, y=前向缩放, z=向上缩放, w=区域掩码
    vec4 suppression;   // xyz=短中长波抑制系数, w=预留
} profileConfig;

// Front LUT 纹理（参数与导数）
layout(set = 0, binding = 4) uniform sampler2D frontParameterLUT;
layout(set = 0, binding = 5) uniform sampler2D frontDerivativeLUT;
// Wave Profile 纹理（位移与导数）
layout(set = 0, binding = 6) uniform sampler2D boreProfileDisplacement;
layout(set = 0, binding = 7) uniform sampler2D boreProfileDerivative;

// 输出：泡沫源与速度图像（RGBA16F）
// R=泡沫源强度, G=速度X, B=速度Z, A=破碎权重
layout(rgba16f, set = 0, binding = 8) uniform writeonly image2D sourceVelocityImage;

// smoothstep 的解析导数，用于后续计算水位抬升的坡度
float SmoothStepDerivative(float edge0, float edge1, float x) {
    if (x <= edge0 || x >= edge1) return 0.0;
    float t = (x - edge0) / (edge1 - edge0);
    return 6.0 * t * (1.0 - t) / (edge1 - edge0);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    int resolution = int(foamSim.solver.y);
    // 超出分辨率范围则跳过
    if (pixel.x >= resolution || pixel.y >= resolution) return;

    // 计算该像素对应的世界空间坐标
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(resolution);
    vec2 worldXZ = foamSim.domain.xy + uv * foamSim.domain.zw;

    // ---------- 与顶点着色器完全一致的 BoreFront 计算 ----------
    vec2 direction = normalize(bore.directionLengthFade.xy);
    vec2 tangent = vec2(-direction.y, direction.x);
    vec2 relative = worldXZ - bore.originSpeedTime.xy;
    float alongFront = dot(relative, tangent);
    float crossFront = dot(relative, direction);
    float frontLength = bore.directionLengthFade.z;
    float frontU = alongFront / frontLength + 0.5;
    float frontUClamped = clamp(frontU, 0.0, 1.0);
    float edgeFade = bore.directionLengthFade.w;
    float lengthMask = smoothstep(0.0, edgeFade, frontU) *
                       (1.0 - smoothstep(1.0 - edgeFade, 1.0, frontU));

    vec4 frontParams = textureLod(frontParameterLUT, vec2(frontUClamped, 0.5), 0.0);
    vec4 derivativeData = textureLod(frontDerivativeLUT, vec2(frontUClamped, 0.5), 0.0);
    float useLUT = bore.lutInfo.z;
    float offsetMeters = mix(0.0, frontParams.r, useLUT);
    float frontPosition = bore.motionDebug.x + bore.originSpeedTime.z * bore.originSpeedTime.w + offsetMeters;
    float signedDistance = crossFront - frontPosition;
    float dOffsetDu = mix(0.0, derivativeData.r, useLUT);
    float dOffsetDa = dOffsetDu / frontLength;
    vec2 localFrontNormal = normalize(direction - dOffsetDa * tangent);

    float foamMultiplier = mix(1.0, frontParams.b, useLUT);
    float profilePhaseOffset = mix(0.0, frontParams.a, useLUT);
    float profileHalfWidth = profileConfig.domain.x;
    float profileU = clamp(signedDistance / (2.0 * profileHalfWidth) + 0.5, 0.0, 1.0);
    float profileDuration = max(profileConfig.domain.w, 0.001);
    float profileVRaw = profileConfig.animation.x / profileDuration +
                        profilePhaseOffset * profileConfig.animation.y;
    bool looping = profileConfig.animation.z > 0.5;
    float profileV = looping ? fract(profileVRaw) : clamp(profileVRaw, 0.0, 1.0);

    vec4 boreProfile = textureLod(boreProfileDisplacement, vec2(profileU, profileV), 0.0);
    vec4 boreDerivative = textureLod(boreProfileDerivative, vec2(profileU, profileV), 0.0);

    float boreEnabled = bore.motionDebug.w;
    float profileEnabled = profileConfig.animation.w;
    float activeRegionMask = profileConfig.geometry.w;

    // 计算涌潮相关的泡沫源：剖面泡沫 + 破碎泡沫
    float profileFoam = boreProfile.b * foamMultiplier * lengthMask *
                        boreEnabled * profileEnabled * activeRegionMask;
    float boreBreakingFoam = boreDerivative.a * foamMultiplier * lengthMask *
                             boreEnabled * profileEnabled * activeRegionMask;

    // 根据 UBO 中的源强度参数，取两者中的最大值作为当前涌潮泡沫源
    float source = max(profileFoam * foam.sourceStrength.x,
                       boreBreakingFoam * foam.sourceStrength.w);
    // 应用全局源缩放
    source *= foam.runtime.y;

    // 流速沿局部波前法线方向，大小取自 Wave Profile 导数纹理的 B 通道
    vec2 velocity = localFrontNormal * boreDerivative.b;

    // 输出：R=泡沫源, G=速度X, B=速度Z, A=破碎权重
    imageStore(sourceVelocityImage, pixel,
               vec4(source, velocity.x, velocity.y, boreDerivative.a));
}